# ==========================================
# TypeScript / Build Output
# ==========================================
# Ignore the directory where TypeScript compiles your files (often 'dist' or 'out')
dist/
out/
build/
bin/

# Ignore TypeScript build cache and incremental compilation files
*.tsbuildinfo

# Ignore generated JavaScript files if you compile them next to your source files
# (Uncomment the lines below if you do NOT use a dedicated 'dist' or 'build' folder)
# src/**/*.js
# src/**/*.js.map
# src/**/*.d.ts

# ==========================================
# Dependencies
# ==========================================
node_modules/
jspm_packages/
web_modules/

# ==========================================
# Logs and Runtime Data
# ==========================================
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Commit the template instead of actual secrets
!.env.example

# ==========================================
# Testing & Coverage
# ==========================================
coverage/
.nyc_output/

# ==========================================
# IDEs and Editors
# ==========================================
# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# WebStorm / IntelliJ
.idea/

# ==========================================
# Operating System Files
# ==========================================
.DS_Store
Thumbs.db
